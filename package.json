{
  "name": "blinq",
  "version": "1.0.0",
  "description": "Self-hosted, end-to-end encrypted video conferencing.",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm vendor && pnpm cli migrate && pnpm cli bootstrap && nuxt dev",
    "dev:deps": "LIVEKIT_NODE_IP=$(sh scripts/detect-ip.sh) docker compose -f docker-compose.dev.yml up -d --wait",
    "dev:deps:logs": "LIVEKIT_NODE_IP=$(sh scripts/detect-ip.sh) docker compose -f docker-compose.dev.yml logs -f --tail=100",
    "build": "pnpm vendor && nuxt build && node scripts/build-cli.mjs",
    "build:test": "pnpm vendor && BLINQ_TEST_HOOKS=1 nuxt build && node scripts/build-cli.mjs",
    "preview": "node --env-file-if-exists=.env --env-file-if-exists=.env.local .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "cli": "tsx --tsconfig .nuxt/tsconfig.server.json --env-file-if-exists=.env --env-file-if-exists=.env.local server/cli.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm cli migrate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck && tsc -p tests/tsconfig.json",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:nuxt": "vitest run --project nuxt",
    "test:api": "vitest run --project api",
    "test:e2e": "sh scripts/e2e.sh",
    "test:e2e:docker": "sh scripts/e2e-docker.sh",
    "check:english": "node scripts/check-english.mjs",
    "vendor": "node scripts/vendor-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@livekit/track-processors": "^0.8.1",
    "@lucide/vue": "^1.48.0",
    "@mediapipe/tasks-vision": "0.10.14",
    "@node-rs/argon2": "^2.2.1",
    "@nuxtjs/color-mode": "^4.0.1",
    "@pinia/nuxt": "^1.0.2",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "@tanstack/vue-form": "^1.33.5",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "consola": "^3.4.2",
    "drizzle-orm": "^0.45.3",
    "h3": "^1.15.11",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.1",
    "nodemailer": "^10.0.11",
    "nuxt": "^4.5.2",
    "nuxt-security": "^2.6.0",
    "pinia": "^4.0.3",
    "postgres": "^3.4.9",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dom-mediacapture-transform": "^0.1.12",
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "@vue/test-utils": "^2.5.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "shadcn-nuxt": "^2.8.2",
    "shadcn-vue": "^2.8.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  }
}
