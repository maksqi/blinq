# E2E reverse proxy (docs/TESTING.md §6.1, docs/ARCHITECTURE.md §3). scripts/e2e.sh (host mode, compose.yml) and
# scripts/e2e-docker.sh (Docker runner, runner.compose.yml) start and stop it.
#
# One origin for the app and LiveKit signaling, as in production, so the production CSP (connect-src 'self') applies
# unchanged. Plain HTTP is enough because http://localhost is a secure context. Caddy sets no security headers (it only
# adds the standard Via header): CSP and the others come from the app itself (production Caddy adds only HSTS).
{
	admin off
	auto_https off
	persist_config off
	# As in production (docker/caddy/entrypoint.sh): the error log drops the query, other host names are not logged.
	log errors {
		include http.log.error
		output stderr
		format filter {
			wrap json
			request>uri regexp \?.*$ ?REDACTED
			request>headers>Referer regexp \?.*$ ?REDACTED
		}
	}
	log default {
		exclude http.log.access http.log.error
	}
}

# Container-local health endpoint for the compose healthcheck (production Caddy uses 127.0.0.1:2020 the same way).
http://127.0.0.1:2020 {
	bind 127.0.0.1
	respond /health 200
}

http://localhost:8080 {
	# The access log ends up in logs/e2e/caddy.log, where the E2E fixtures scan it for secrets. Host mode logs to stdout
	# and scripts/e2e.sh copies it there; the Docker runner sets E2E_ACCESS_LOG_OUTPUT to write the file directly.
	# The same two loggers as production (docker/caddy/site.caddyfile explains the names): /api and /rtc redact
	# credential parameters, every other path loses its whole query.
	log api {
		output {$E2E_ACCESS_LOG_OUTPUT:stdout}
		format filter {
			wrap json
			request>uri query {
				replace access_token REDACTED
				replace join_request REDACTED
				replace t REDACTED
				replace k REDACTED
				replace token REDACTED
				replace inviteToken REDACTED
				replace proof REDACTED
				replace password REDACTED
				replace currentPassword REDACTED
				replace newPassword REDACTED
				replace confirmPassword REDACTED
				replace email REDACTED
				replace link REDACTED
				replace q REDACTED
			}
			request>headers>Referer regexp \?.*$ ?REDACTED
			resp_headers>Location regexp \?.*$ ?REDACTED
		}
	}
	log pages {
		output {$E2E_ACCESS_LOG_OUTPUT:stdout}
		format filter {
			wrap json
			request>uri regexp \?.*$ ?REDACTED
			request>headers>Referer regexp \?.*$ ?REDACTED
			resp_headers>Location regexp \?.*$ ?REDACTED
		}
	}
	@log_api path /api /api/* /rtc /rtc/*
	log_name @log_api api
	@log_pages not path /api /api/* /rtc /rtc/*
	log_name @log_pages pages

	# As in production (docker/caddy/site.caddyfile), so perf/budget measures the compressed transfer sizes.
	# Text-based responses only. Not text/event-stream (the waiting-room SSE), which must reach the browser at once.
	encode {
		zstd
		gzip
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/plain*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type application/manifest+json*
			header Content-Type application/wasm*
			header Content-Type image/svg+xml*
		}
	}

	# LiveKit posts webhooks to the app directly; they are never reachable through the public origin.
	@webhooks path /api/webhooks /api/webhooks/*
	handle @webhooks {
		respond 404
	}

	# LiveKit signaling only (/rtc/v1, /rtc/v1/validate and the legacy /rtc paths). /twirp is never proxied.
	@lk path /rtc /rtc/*
	handle @lk {
		reverse_proxy {$E2E_LIVEKIT_UPSTREAM:livekit:7880}
	}

	# Everything else goes to the app. reverse_proxy flushes text/event-stream (SSE) responses immediately.
	# flush_interval -1 is deliberately not set: it would keep upstream requests open after the browser disconnects.
	handle {
		reverse_proxy {$E2E_APP_UPSTREAM:host.docker.internal:3000}
	}
}
